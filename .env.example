# Loaded by apps/server and apps/dashboard from the repository root.
HOST=127.0.0.1
PORT=3000
# Dashboard status API is local-only; the display publisher talks to the gateway.
DASHBOARD_PORT=3001
# Empty = http://127.0.0.1:<PORT>
DASHBOARD_SERVER_URL=
# Dashboard only: read this PC's Codex/Claude activity.
LOCAL_AGENT_MONITOR=0
# Experimental Claude Code cloud metadata (uses existing CLI OAuth login).
CLAUDE_CLOUD_MONITOR=0
# Header quota badges; active with LOCAL_AGENT_MONITOR=1. Set 0 to disable.
USAGE_MONITOR=1
# Optional Codex executable path. Defaults to installed desktop CLI, then PATH.
CODEX_BIN=
DATABASE_PATH=./.local/dashboard.db
# Optional write API bearer token. Never expose this via VITE_* or app.json.
API_TOKEN=
# Optional comma-separated origins for a separately hosted Plugin.
CORS_ORIGINS=
# Packaged Plugin only: set a reachable HTTPS origin, then rebuild/repack.
# Vite dev and the server-hosted Plugin default to the page origin.
VITE_AGENT_SERVER_URL=
